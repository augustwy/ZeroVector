# ZeroVector Spring Boot 示例配置

# 方式一：复用Spring AI的配置（推荐）
# 只需要配置spring.ai，ZeroVector会自动复用这些配置
spring:
  ai:
    openai:
      api-key: ${OPENAI_API_KEY}
      chat:
        options:
          model: gpt-3.5-turbo
          temperature: 0.7

# ZeroVector配置
zerovector:
  enabled: true
  llm-provider: spring-ai
  reuse-spring-ai-config: true  # 复用Spring AI的配置
  storage-path: ./zerovector_storage
  use-sharded-storage: true
  shard-size: 100

---
# 方式二：使用ZeroVector独立的Spring AI配置
# 如果不想复用Spring AI的配置，可以单独配置
spring:
  # 其他Spring配置...

zerovector:
  enabled: true
  llm-provider: spring-ai
  reuse-spring-ai-config: false  # 不复用Spring AI的配置
  spring-ai:
    chat-model: openai
    api-key: ${OPENAI_API_KEY}
    api-url: https://api.openai.com
    temperature: 0.7
  storage-path: ./zerovector_storage
  use-sharded-storage: true
  shard-size: 100

---
# 方式三：使用LangChain4j
spring:
  # 其他Spring配置...

zerovector:
  enabled: true
  llm-provider: langchain4j
  langchain4j:
    chat-model: gpt-3.5-turbo
    api-key: ${OPENAI_API_KEY}
    api-url: https://api.openai.com
    temperature: 0.7
    timeout: 60
  storage-path: ./zerovector_storage
  use-sharded-storage: true
  shard-size: 100

---
# 方式四：使用第三方模型提供商（阿里百炼）
# 通过适配器扩展支持第三方模型提供商
spring:
  # 其他Spring配置...

zerovector:
  enabled: true
  llm-provider: spring-ai
  reuse-spring-ai-config: false  # 不复用Spring AI的配置
  spring-ai:
    chat-model: ali-qwen-turbo  # 阿里百炼模型
    api-key: ${ALI_API_KEY}      # 阿里云API密钥
    temperature: 0.7
  storage-path: ./zerovector_storage
  use-sharded-storage: true
  shard-size: 100
  # 启用第三方模型提供商适配器
  third-party:
    enabled: true
    ali-bailian:
      enabled: true

---
# 方式五：使用第三方模型提供商（百度文心）
# 通过ZeroVector独立的Spring AI配置，支持第三方模型提供商
spring:
  # 其他Spring配置...

zerovector:
  enabled: true
  llm-provider: spring-ai
  reuse-spring-ai-config: false  # 不复用Spring AI的配置
  spring-ai:
    chat-model: baidu-ernie-bot   # 百度文心模型
    api-key: ${BAIDU_API_KEY}     # 百度API密钥
    temperature: 0.7
  storage-path: ./zerovector_storage
  use-sharded-storage: true
  shard-size: 100

---
# 方式六：使用第三方模型提供商（智谱AI）
# 通过ZeroVector独立的Spring AI配置，支持第三方模型提供商
spring:
  # 其他Spring配置...

zerovector:
  enabled: true
  llm-provider: spring-ai
  reuse-spring-ai-config: false  # 不复用Spring AI的配置
  spring-ai:
    chat-model: zhipu-glm-4       # 智谱AI模型
    api-key: ${ZHIPU_API_KEY}     # 智谱API密钥
    temperature: 0.7
  storage-path: ./zerovector_storage
  use-sharded-storage: true
  shard-size: 100