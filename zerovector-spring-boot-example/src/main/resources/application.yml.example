# ZeroVector 示例配置
# 完整属性以 ZeroVectorProperties / ConcurrencyProperties 为准。

spring:
  ai:
    openai:
      api-key: ${AI_OPENAI_API_KEY}
      base-url: ${AI_OPENAI_BASE_URL:https://api.openai.com}

zerovector:
  enabled: true
  storage-base-path: ./data/knowledge_bases
  shard-size: 100

  model:
    heavy: gpt-4o-mini
    light: gpt-4o-mini
    fast: gpt-4o-mini
    temperature: 0.7
    max-tokens: -1

  concurrency:
    max-concurrent-requests: 2
    max-navigation-steps: 20

  llm-context:
    # 单次送给 LLM 的最大字符数（不是 token 数）
    max-chunk-chars: 4000
    # 超过该字符数才按章节切片；小文档整篇作为一个检索单位
    chapter-split-threshold-chars: 100000

  rate-limit:
    enabled: false
    max-requests: 5
    window-seconds: 60

  cache:
    enabled: true
    smart-cache:
      similarity-threshold: 0.85
      max-similarity-length: 500
      enable-similarity-matching: true
    comprehend-chunk:
      max-size: 5000
      expire-after-access: 4
      time-unit: HOURS
    generate-summary:
      max-size: 2000
      expire-after-access: 2
      time-unit: HOURS
    cluster-documents:
      max-size: 1000
      expire-after-access: 6
      time-unit: HOURS
    extract-keywords:
      max-size: 3000
      expire-after-access: 8
      time-unit: HOURS
    extract-entities:
      max-size: 3000
      expire-after-access: 8
      time-unit: HOURS
    generate-example-questions:
      max-size: 2000
      expire-after-access: 12
      time-unit: HOURS
    decide-navigation:
      max-size: 5000
      expire-after-access: 1
      time-unit: HOURS

  hook:
    enabled: true
    hooks: []
